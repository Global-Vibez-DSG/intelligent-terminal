{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Intelligent Terminal Product Manifest",
  "description": "Schema for integration/product-manifest.json — machine-readable product data consumed by the companion website.",
  "type": "object",
  "required": ["schemaVersion", "product", "install", "features", "supportedAgents", "manifestMeta"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Semver of this schema."
    },
    "product": {
      "type": "object",
      "required": ["id", "name", "tagline", "description", "companionWebsite", "repositoryUrl"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string", "description": "Current release version, e.g. 0.8.0.2. Set by update-manifest.yml." },
        "category": { "type": "string" },
        "platform": { "type": "string" },
        "minWindowsVersion": { "type": "string" },
        "companionWebsite": { "type": "string", "format": "uri" },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "issuesUrl": { "type": "string", "format": "uri" },
        "releasesUrl": { "type": "string", "format": "uri" },
        "docsUrl": { "type": "string", "format": "uri" },
        "privacyUrl": { "type": "string", "format": "uri" },
        "logoUrl": { "type": "string", "format": "uri" }
      }
    },
    "install": {
      "type": "object",
      "properties": {
        "store": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "recommended": { "type": "boolean" }
          }
        },
        "winget": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "packageId": { "type": "string" },
            "command": { "type": "string" }
          }
        },
        "download": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "shortcut": { "type": "string" },
          "imageUrl": { "type": "string", "format": "uri" },
          "docsUrl": { "type": "string", "format": "uri" }
        }
      }
    },
    "supportedAgents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "builtIn": { "type": "boolean" }
        }
      }
    },
    "shortcuts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keys", "action"],
        "properties": {
          "keys": { "type": "string" },
          "action": { "type": "string" }
        }
      }
    },
    "systemRequirements": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "architecture": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string", "format": "uri" }
    },
    "manifestMeta": {
      "type": "object",
      "required": ["lastUpdated", "maintainedBy", "rawUrl"],
      "properties": {
        "lastUpdated": { "type": "string", "description": "ISO 8601 date of last update." },
        "maintainedBy": { "type": "string" },
        "consumedBy": { "type": "string", "format": "uri" },
        "rawUrl": { "type": "string", "format": "uri" },
        "notes": { "type": "string" }
      }
    }
  }
}
