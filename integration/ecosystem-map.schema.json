{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Global Vibez Ecosystem Map",
  "description": "Machine-readable inventory and coordination policy for Global Vibez repositories and cross-repo automation.",
  "type": "object",
  "required": ["schemaVersion", "organization", "sharedPolicies", "repos"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "organization": {
      "type": "object",
      "required": ["name", "website", "defaultBranch", "releaseTagPrefix", "syncDispatchEvent"],
      "properties": {
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "defaultBranch": { "type": "string" },
        "releaseTagPrefix": { "type": "string" },
        "syncDispatchEvent": { "type": "string" }
      }
    },
    "sharedPolicies": {
      "type": "object",
      "required": ["branchProtection", "releaseCadence", "dependencyUpdates", "requiredChecks"],
      "properties": {
        "branchProtection": {
          "type": "object",
          "properties": {
            "protectedBranches": {
              "type": "array",
              "items": { "type": "string" }
            },
            "requirePullRequest": { "type": "boolean" },
            "requireStatusChecks": { "type": "boolean" },
            "requireLinearHistory": { "type": "boolean" }
          }
        },
        "releaseCadence": {
          "type": "object",
          "properties": {
            "stableTrigger": { "type": "string" },
            "prereleaseTrigger": { "type": "string" },
            "websiteRefresh": { "type": "string" }
          }
        },
        "dependencyUpdates": {
          "type": "object",
          "properties": {
            "schedule": { "type": "string" },
            "day": { "type": "string" },
            "timeUtc": { "type": "string" }
          }
        },
        "requiredChecks": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fullName", "defaultBranch", "role", "primaryOwner", "syncEnabled"],
        "properties": {
          "id": { "type": "string" },
          "fullName": { "type": "string" },
          "defaultBranch": { "type": "string" },
          "role": { "type": "string" },
          "primaryOwner": { "type": "string" },
          "backupOwners": {
            "type": "array",
            "items": { "type": "string" }
          },
          "websiteSurface": { "type": "string", "format": "uri" },
          "syncEnabled": { "type": "boolean" },
          "syncMode": { "type": "string" },
          "manifestSource": { "type": "string", "format": "uri" },
          "releaseSource": { "type": "string", "format": "uri" },
          "notes": { "type": "string" },
          "dependsOn": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
